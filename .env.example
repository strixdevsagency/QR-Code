# =================================================================
# STRIX QR — ENVIRONMENT & AUTHENTICATION CONFIGURATION
# =================================================================

# 1. Base Domain & Application URL
NEXT_PUBLIC_APP_URL=https://qr.strixdevs.com
NEXT_PUBLIC_APP_NAME="Strix QR"

# 2. Centralized Supabase Integration (auth.strixdevs.com / supabase.co)
# Supports the latest Supabase Publishable Key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here
# Legacy fallback (optional):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Shared Cookie Domain for Multi-Service SSO (*.strixdevs.com)
# Enables seamless login across qr.strixdevs.com, link.strixdevs.com, etc.
NEXT_PUBLIC_COOKIE_DOMAIN=.strixdevs.com

# 4. Telemetry & Monetization (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXX
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-XXXXXXXXXXXXXXXX

# SMTP Email Configuration for Nodemailer
SMTP_HOST="gmail.com"
SMTP_PORT=400
SMTP_SECURE=true
SMTP_USER=strixdevs1.0@gmail.com
SMTP_PASS="password-for-smtp-here"
